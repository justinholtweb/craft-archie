{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Settings"|t('archie') %}
{% set selectedSubnavItem = 'settings' %}

{% block content %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('archie/settings/save') }}

        <div class="pane">
            {% include 'archie/_settings' with { settings: settings, directory: directory } only %}
        </div>

        <button type="submit" class="btn submit">{{ "Save"|t('archie') }}</button>
    </form>
{% endblock %}
