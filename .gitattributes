# Keep the distributed package to what a site actually needs at runtime.
# docs/ stays: the README links into it.
/.gitattributes    export-ignore
/.gitignore        export-ignore
/phpunit.xml       export-ignore
/tests             export-ignore
/promos            export-ignore
# Source artwork for src/icon.svg. Kept in git, not shipped to every install.
/src/icon.jpg      export-ignore
